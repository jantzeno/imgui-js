{
  "name": "imgui-js",
  "version": "2.0.0",
  "description": "Dear ImGui for TypeScript with SDL3 and WebGL2",
  "type": "module",
  "main": "./dist/imgui.js",
  "types": "./dist/imgui.d.ts",
  "exports": {
    ".": {
      "types": "./dist/imgui.d.ts",
      "import": "./dist/imgui.js"
    },
    "./bind-imgui.wasm": "./dist/bind-imgui.wasm"
  },
  "files": [
    "dist/",
    "LICENSE.txt",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "scripts": {
    "build": "npm run build:wasm && npm run build:ts",
    "build:wasm": "node scripts/build.mjs",
    "build:ts": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"for (const p of ['dist', 'build', 'src/enums.ts', 'src/bind-imgui.d.ts']) require('node:fs').rmSync(p, {recursive:true, force:true})\"",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "start": "node scripts/serve.mjs",
    "prepack": "npm run build",
    "build:debug": "node scripts/build.mjs --debug && npm run build:ts"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Isaac Burns <isaacburns@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jantzeno/imgui-js.git"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2"
  }
}
